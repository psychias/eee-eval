# Every Eval Ever — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data directory — large; not committed to git
# (upload to Hugging Face Hub instead)
data/

# Raw scraper output (large JSON dumps)
src/scrapers/raw/

# Caches
.cache/

# Generated results / figures (reproducible)
results/
analysis_output/
harness_experiment_output/

# PDF compilation artefacts
submission/latex/*.aux
submission/latex/*.log
submission/latex/*.out
submission/latex/*.toc
submission/latex/*.synctex.gz
submission/latex/*.bbl
submission/latex/*.blg
submission/latex/*.fls
submission/latex/*.fdb_latexmk

# Validation reports (generated at runtime)
VALIDATION_REPORT.json
reports/

# macOS
.DS_Store
.localized

# pip / mypy
pip-wheel-metadata/
*.whl
.mypy_cache/
.dmypy.json

# Lock files
uv.lock

# Claude / Copilot agent metadata
.claude/
CLAUDE.md
dmypy.json
