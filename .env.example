# Required: OpenRouter API key for LLM extraction (src/extraction/extract_paper.py)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Required for the leaderboard / HF model-card fetchers
# (src/extraction/add_leaderboard_records.py, hf_model_card_fetcher.py):
# a HuggingFace access token. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: custom CA bundle if TLS verification fails in your environment
# REQUESTS_CA_BUNDLE=/path/to/custom-ca-bundle.crt
